{
  "name": "study-report",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend:unit": "python3 -m pytest backend/tests/unit -m unit --cov=backend --cov-report=term-missing --cov-fail-under=30",
    "test:backend:integration": "python3 -m pytest backend/tests/integration -m integration --cov=backend --cov-report=term-missing --cov-fail-under=30",
    "test:backend": "python3 -m pytest backend/tests -m \"unit or integration\" --cov=backend --cov-report=term-missing --cov-fail-under=30",
    "test:frontend:unit": "vitest run src/tests/unit --coverage --run",
    "test:frontend:integration": "vitest run src/tests/integration --coverage --run",
    "test:frontend": "vitest run src/tests --coverage --run",
    "test:e2e": "playwright test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "-": "^0.0.1",
    "axios": "^1.12.2",
    "node": "^24.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/react-router-dom": "^5.3.3",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^27.0.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
