# Database
POSTGRES_DB=study_report
POSTGRES_USER=study_user
POSTGRES_PASSWORD=study_password
DATABASE_URL=postgresql://study_user:study_password@localhost:5433/study_report

# App
APP_ENV=development
ENABLE_DOCS=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173

# JWT
JWT_SECRET_KEY=your-unique-access-secret-key
JWT_REFRESH_SECRET_KEY=your-unique-refresh-secret-key
JWT_REFRESH_EXPIRE_DAYS=7

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-minio-password
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your-minio-password
MINIO_BUCKET=study-reports
MINIO_SECURE=false

# Frontend
VITE_API_URL=/api

# External API
EXTERNAL_API_URL=https://api.api-ninjas.com/v1/quotes?category=education
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=6
EXTERNAL_API_MAX_RETRIES=3
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=20
